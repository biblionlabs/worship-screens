@rust-attr(derive(serde::Serialize, serde::Deserialize))
export struct ViewBackgroundColor {
    a: color,
    b: color,
}

@rust-attr(derive(serde::Serialize, serde::Deserialize))
export struct ViewFontData {
    name: string,
    color: color,
    stroke: color,
    stroke-size: length,
    font-size: length,
}

export struct ViewData {
    path: string,
    tmp: bool,
    is-logo: bool,
    show-img: bool,
    color: ViewBackgroundColor,
    content: string,
    verse: string,
    img-bg: image,
    img-fit: ImageFit,
    font: ViewFontData,
    verse-font: ViewFontData,
}

@rust-attr(derive(serde::Serialize, serde::Deserialize))
export struct TextView {
    color: ViewBackgroundColor,
    content: string,
    font: ViewFontData,
}

export struct EditMode {
    editable: bool,
    row: int,
    col: int,
}

export global FontState {
    in-out property <ViewFontData> main;
    in-out property <ViewFontData> verse;

    in-out property <ViewFontData> media-main;
    in-out property <ViewFontData> media-verse;

    callback sync();

    public pure function default() -> ViewFontData {
        return {
            color: Colors.white,
            stroke: Colors.black,
            stroke-size: 2px,
            font-size: 120px,
        };
    }

    public function set-main(data: ViewFontData) {
        FontState.main.name = data.name;
        FontState.main.color = data.color;
        FontState.main.font-size = data.font-size;
        FontState.main.stroke = data.stroke;
        FontState.main.stroke-size = data.stroke-size;
    }
    public function set-verse(data: ViewFontData) {
        FontState.verse.name = data.name;
        FontState.verse.color = data.color;
        FontState.verse.font-size = data.font-size;
        FontState.verse.stroke = data.stroke;
        FontState.verse.stroke-size = data.stroke-size;
    }
    public function set-media-main(data: ViewFontData) {
        FontState.media-main.name = data.name;
        FontState.media-main.color = data.color;
        FontState.media-main.font-size = data.font-size;
        FontState.media-main.stroke = data.stroke;
        FontState.media-main.stroke-size = data.stroke-size;
    }
    public function set-media-verse(data: ViewFontData) {
        FontState.media-verse.name = data.name;
        FontState.media-verse.color = data.color;
        FontState.media-verse.font-size = data.font-size;
        FontState.media-verse.stroke = data.stroke;
        FontState.media-verse.stroke-size = data.stroke-size;
    }
}

export global ViewState {
    in property <bool> off: false;

    in property <ViewData> select-media-preview: default-view-data();
    in-out property <ViewData> shared-view: default-view-data();
    in property <[[ViewData]]> media-list;
    in property <[string]> installed-fonts: [];

    in property <EditMode> in-edit-mode: {
        editable: false,
        row: -1,
        col: -1,
    };
    in property <length> window-width: 720px - 30px;
    in property <length> window-height: 423px - 30px;

    callback apply-changes(EditMode);
    callback select-file();

    callback show-logo();
    callback remove-media(int, int);
    callback preview-media(ViewData);
    callback sync-and-play(ViewData);

    public pure function default-view-data() -> ViewData {
        return {
            show-img: false,
            img-fit: ImageFit.contain,
            color: { a: Colors.black, b: Colors.black },
        };
    }

    public pure function color-to-view(c: color) -> ViewBackgroundColor {
        return {
            a: c,
            b: c,
        };
    }

    public function set-shared-view(view-data: ViewData) {
        ViewState.shared-view.content = view-data.content;
        ViewState.shared-view.verse = view-data.verse;
        ViewState.shared-view.color = view-data.color;

        if view-data.show-img {
            ViewState.shared-view.show-img = view-data.show-img;
            ViewState.shared-view.img-bg = view-data.img-bg;
            ViewState.shared-view.img-fit = view-data.img-fit;
            ViewState.shared-view.path = view-data.path;
            ViewState.shared-view.is-logo = view-data.is-logo;
        }
    }
}
